// CUT CORE-0.2-SERVICE-POLICY-20260920 — ADR-246 oracle core02-policy-header-cap
// Low max_header_count/bytes; Measure: request with many/large headers → reject pre-handler.
module core02_policy_header_cap

async fn handle(req: HttpRequest) -> Result<HttpResponse, IoError> {
  let resp: HttpResponse = HttpResponse.ok_text("should-not-see")
  let out: Result<HttpResponse, IoError> = Ok(resp)
  out
}

async fn main() -> Io<()> {
  let s: Result<HttpServer, IoError> = HttpServer.bind("127.0.0.1", 0)
  match s {
    Err(e) => { print(e) }
    Ok(srv) => {
      let tight: ServicePolicy = ServicePolicy {
        max_body_bytes: 1048576,
        max_header_bytes: 64,
        max_header_count: 2,
        idle_timeout_ms: 30000
      }
      let r: Result<HttpServer, IoError> = srv.set_policy(tight)
      match r {
        Err(e) => { print(e) }
        Ok(srv2) => {
          let port: Int = srv2.port()
          print(port)
          print("header-cap-ready")
          let serve_r: Result<(), IoError> = srv2.serve(handle)
          match serve_r {
            Ok(_) => { print("done") }
            Err(e) => { print(e) }
          }
        }
      }
    }
  }
}
