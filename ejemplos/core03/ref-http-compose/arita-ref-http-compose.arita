// CUT CORE-0.3-REF-COMPOSE-20260920 — ADR-253 ref `arita-ref-http-compose`
// Gateway GET /health · POST /pipeline (A→B seq ADR-251). Errors ADR-250.
// Fixed ports (spawn zero-arg MVP): gw 19970 · A 19971 · B 19972.
// Companion `ref-gw-port0.arita` = dual bind 0 for Measure. No new APIs. NOT PASS until Measure.
module arita_ref_http_compose

async fn handle_a(req: HttpRequest) -> Result<HttpResponse, IoError> {
  let body_r: Result<Text, IoError> = req.body_text()
  match body_r {
    Err(e) => {
      let out: Result<HttpResponse, IoError> = Err(e)
      out
    }
    Ok(body) => {
      let resp: HttpResponse = HttpResponse.ok_text(body)
      let out: Result<HttpResponse, IoError> = Ok(resp)
      out
    }
  }
}

async fn handle_b(req: HttpRequest) -> Result<HttpResponse, IoError> {
  let body_r: Result<Text, IoError> = req.body_text()
  match body_r {
    Err(e) => {
      let out: Result<HttpResponse, IoError> = Err(e)
      out
    }
    Ok(body) => {
      let resp: HttpResponse = HttpResponse.ok_text(body)
      let out: Result<HttpResponse, IoError> = Ok(resp)
      out
    }
  }
}

async fn handle_gw(req: HttpRequest) -> Result<HttpResponse, IoError> {
  let path: Text = req.path()
  let health: Text = "/health"
  let is_h: Bool = path == health
  match is_h {
    true => {
    let resp: HttpResponse = HttpResponse.ok_text("{\"ok\":true,\"service\":\"arita-ref-http-compose\"}")
    let out: Result<HttpResponse, IoError> = Ok(resp)
    out
    }
    false => {
    let body_r: Result<Text, IoError> = req.body_text()
    match body_r {
      Err(e) => {
        let out: Result<HttpResponse, IoError> = Err(e)
        out
      }
      Ok(in_body) => {
        let url_a: Text = HttpClient.url(19971, "/step-a")
        let a_res: Result<HttpResponse, IoError> = HttpClient.post_text(url_a, in_body)
        match a_res {
          Err(_e) => {
            let resp: HttpResponse = HttpResponse.status(502, "upstream_unavailable")
            let out: Result<HttpResponse, IoError> = Ok(resp)
            out
          }
          Ok(a) => {
            let st: Int = a.status()
            match st {
              200 => {
                let br: Result<Text, IoError> = a.body_text()
                match br {
                  Err(_e2) => {
                    let resp: HttpResponse = HttpResponse.status(502, "upstream_unavailable")
                    let out: Result<HttpResponse, IoError> = Ok(resp)
                    out
                  }
                  Ok(ta) => {
                    let url_b: Text = HttpClient.url(19972, "/step-b")
                    let b_res: Result<HttpResponse, IoError> = HttpClient.post_text(url_b, ta)
                    match b_res {
                      Err(_e3) => {
                        let resp: HttpResponse = HttpResponse.status(502, "upstream_unavailable")
                        let out: Result<HttpResponse, IoError> = Ok(resp)
                        out
                      }
                      Ok(b) => {
                        let st_b: Int = b.status()
                        match st_b {
                          200 => {
                            let br2: Result<Text, IoError> = b.body_text()
                            match br2 {
                              Err(_e4) => {
                                let resp: HttpResponse = HttpResponse.status(502, "upstream_unavailable")
                                let out: Result<HttpResponse, IoError> = Ok(resp)
                                out
                              }
                              Ok(tb) => {
                                let resp: HttpResponse = HttpResponse.ok_text(tb)
                                let out: Result<HttpResponse, IoError> = Ok(resp)
                                out
                              }
                            }
                          }
                          _ => {
                            let brf: Result<Text, IoError> = b.body_text()
                            match brf {
                              Ok(fb) => {
                                let resp: HttpResponse = HttpResponse.status(st_b, fb)
                                let out: Result<HttpResponse, IoError> = Ok(resp)
                                out
                              }
                              Err(_e5) => {
                                let resp: HttpResponse = HttpResponse.status(st_b, "upstream_error")
                                let out: Result<HttpResponse, IoError> = Ok(resp)
                                out
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
              _ => {
                let brf: Result<Text, IoError> = a.body_text()
                match brf {
                  Ok(fb) => {
                    let resp: HttpResponse = HttpResponse.status(st, fb)
                    let out: Result<HttpResponse, IoError> = Ok(resp)
                    out
                  }
                  Err(_e6) => {
                    let resp: HttpResponse = HttpResponse.status(st, "upstream_error")
                    let out: Result<HttpResponse, IoError> = Ok(resp)
                    out
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  }
}

async fn run_a() -> Io<()> {
  let s: Result<HttpServer, IoError> = HttpServer.bind("127.0.0.1", 19971)
  match s {
    Err(e) => { print(e) }
    Ok(srv) => {
      let r: Result<(), IoError> = srv.serve(handle_a)
      match r {
        Ok(_) => {}
        Err(e) => { print(e) }
      }
    }
  }
}

async fn run_b() -> Io<()> {
  let s: Result<HttpServer, IoError> = HttpServer.bind("127.0.0.1", 19972)
  match s {
    Err(e) => { print(e) }
    Ok(srv) => {
      let r: Result<(), IoError> = srv.serve(handle_b)
      match r {
        Ok(_) => {}
        Err(e) => { print(e) }
      }
    }
  }
}

async fn run_gw() -> Io<()> {
  let s: Result<HttpServer, IoError> = HttpServer.bind("127.0.0.1", 19970)
  match s {
    Err(e) => { print(e) }
    Ok(srv) => {
      let p: ServicePolicy = ServicePolicy.default()
      let sp: Result<HttpServer, IoError> = srv.set_policy(p)
      match sp {
        Err(e) => { print(e) }
        Ok(srv2) => {
          print(srv2.port())
          print("ref-compose-ready")
          let r: Result<(), IoError> = srv2.serve(handle_gw)
          match r {
            Ok(_) => {}
            Err(e) => { print(e) }
          }
        }
      }
    }
  }
}

async fn main() -> Io<()> {
  let ta: Task = spawn(run_a())
  let tb: Task = spawn(run_b())
  delay(200)
  let tg: Task = spawn(run_gw())
  delay(250)
  let uh: Text = HttpClient.url(19970, "/health")
  let gh: Result<HttpResponse, IoError> = HttpClient.get(uh)
  match gh {
    Err(e) => { print(e) }
    Ok(resp) => {
      print(resp.status())
      let br: Result<Text, IoError> = resp.body_text()
      match br {
        Ok(b) => { print(b) }
        Err(e) => { print(e) }
      }
    }
  }
  let up: Text = HttpClient.url(19970, "/pipeline")
  let pe: Result<HttpResponse, IoError> = HttpClient.post_text(up, "ref-compose-ping")
  match pe {
    Err(e) => { print(e) }
    Ok(resp) => {
      print(resp.status())
      let br: Result<Text, IoError> = resp.body_text()
      match br {
        Ok(b) => { print(b) }
        Err(e) => { print(e) }
      }
    }
  }
  print("ref-http-compose-done")
}
