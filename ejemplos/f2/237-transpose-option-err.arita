// ADR-200 std-transpose-option-err — Some(Err("x")).transpose() → Err("x")
module std_transpose_option_err

fn main() -> Io<()> {
  let inner: Result<Int, String> = Err("x")
  let o: Option<Result<Int, String>> = Some(inner)
  let t: Result<Option<Int>, String> = o.transpose()
  match t {
    Ok(opt) => {
      if let Some(n) = opt {
        print(n)
      } else {
        print("none")
      }
    }
    Err(e) => { print(e) }
  }
}
