// ADR-190 std-vec-binary-search-err — [1,3,5].binary_search(4) → Err(2)
module std_vec_binary_search_err

fn main() -> Io<()> {
  let mut v: Vec<Int> = Vec::new()
  v.push(1)
  v.push(3)
  v.push(5)
  let r: Result<Int, Int> = v.binary_search(4)
  match r {
    Ok(i) => { print(i) }
    Err(i) => { print(i) }
  }
}
