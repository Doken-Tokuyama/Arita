// ADR-190 std-vec-binary-search-ok — [1,2,3].binary_search(2) → Ok(1)
module std_vec_binary_search_ok

fn main() -> Io<()> {
  let mut v: Vec<Int> = Vec::new()
  v.push(1)
  v.push(2)
  v.push(3)
  let r: Result<Int, Int> = v.binary_search(2)
  match r {
    Ok(i) => { print(i) }
    Err(i) => { print(i) }
  }
}
