// ADR-198 std-result-flatten-err — Err("outer").flatten() → Err("outer")
module std_result_flatten_err

fn main() -> Io<()> {
  let r: Result<Result<Int, String>, String> = Err("outer")
  let f: Result<Int, String> = r.flatten()
  match f {
    Ok(n) => { print(n) }
    Err(e) => { print(e) }
  }
}
