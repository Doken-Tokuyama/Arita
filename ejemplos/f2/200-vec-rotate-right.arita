// ADR-170 std-vec-rotate-right — [1,2,3] → [3,1,2]
module std_vec_rotate_right

fn main() -> Io<()> {
  let mut v: Vec<Int> = Vec::new()
  v.push(1)
  v.push(2)
  v.push(3)
  v.rotate_right(1)
  let a: Option<Int> = v.get(0)
  let b: Option<Int> = v.get(1)
  let c: Option<Int> = v.get(2)
  if let Some(x) = a {
    if let Some(y) = b {
      if let Some(z) = c {
        if x == 3 {
          if y == 1 {
            if z == 2 {
              print("ok")
            } else {
              print("bad")
            }
          } else {
            print("bad")
          }
        } else {
          print("bad")
        }
      } else {
        print("bad")
      }
    } else {
      print("bad")
    }
  } else {
    print("bad")
  }
}
