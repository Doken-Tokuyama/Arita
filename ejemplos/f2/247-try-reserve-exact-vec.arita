// ADR-206 std-try-reserve-exact-vec — Ok + capacity ≥ n
module std_try_reserve_exact_vec

fn main() -> Io<()> {
  let mut v: Vec<Int> = Vec::new()
  let r: Result<(), Int> = v.try_reserve_exact(8)
  match r {
    Ok(u) => {
      let c: Int = v.capacity()
      if c >= 8 {
        print("ok")
      } else {
        print("bad")
      }
    }
    Err(e) => { print(e) }
  }
}
