// ADR-206 std-try-reserve-exact-string — Ok + capacity ≥ n
module std_try_reserve_exact_string

fn main() -> Io<()> {
  let mut s: String = ""
  let r: Result<(), Int> = s.try_reserve_exact(8)
  match r {
    Ok(u) => {
      let c: Int = s.capacity()
      if c >= 8 {
        print("ok")
      } else {
        print("bad")
      }
    }
    Err(e) => { print(e) }
  }
}
