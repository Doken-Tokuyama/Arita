// ADR-263 — CLI happy: lib insert Ok + index Some; stdout coll-ref-happy
module arita_ref_collections

use lib::BagSpec
use lib::build_mid
use lib::peek_mid

fn main() -> Io<()> {
  let c: BagSpec = BagSpec { seed: 1 }
  let r1: Result<Int, Int> = build_mid(c.seed)
  match r1 {
    Ok(a) => {
      let r2: Result<Int, Int> = peek_mid(c.seed)
      match r2 {
        Ok(b) => {
          if a == 9 {
            if b == 9 {
              print("coll-ref-happy")
            } else {
              print("bad-b")
            }
          } else {
            print(a)
          }
        }
        Err(e) => { print(e) }
      }
    }
    Err(e) => { print(e) }
  }
}

scenario ref_coll_happy {
  acceptance "coll-ref-happy"
}
