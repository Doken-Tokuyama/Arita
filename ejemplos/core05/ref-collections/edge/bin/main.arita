// ADR-263 — CLI oob: lib insert Err + index None; stdout coll-ref-oob
module arita_ref_collections_oob

use lib::BagSpec
use lib::build_oob
use lib::peek_oob

fn main() -> Io<()> {
  let c: BagSpec = BagSpec { seed: 1 }
  let r1: Result<Int, Int> = build_oob(c.seed)
  match r1 {
    Ok(a) => { print(a) }
    Err(e) => {
      let r2: Result<Int, Int> = peek_oob(c.seed)
      match r2 {
        Ok(b) => { print(b) }
        Err(e2) => {
          if e == 0 {
            if e2 == 0 {
              print("coll-ref-oob")
            } else {
              print(e2)
            }
          } else {
            print(e)
          }
        }
      }
    }
  }
}

scenario ref_coll_oob {
  acceptance "coll-ref-oob"
}
