// ADR-260 — insert in-range → Ok + order [1,9,3]
module core05_insert_ok

fn main() -> Io<()> {
  let mut v: Vec<Int> = Vec::new()
  v.push(1)
  v.push(3)
  let r: Result<(), Int> = v.insert(1, 9)
  match r {
    Ok(u) => {
      let a: Option<Int> = v.get(0)
      let b: Option<Int> = v.get(1)
      let c: Option<Int> = v.get(2)
      if let Some(x) = a {
        if let Some(y) = b {
          if let Some(z) = c {
            if x == 1 {
              if y == 9 {
                if z == 3 {
                  print("ok")
                } else {
                  print("bad")
                }
              } else {
                print("bad")
              }
            } else {
              print("bad")
            }
          } else {
            print("bad")
          }
        } else {
          print("bad")
        }
      } else {
        print("bad")
      }
    }
    Err(e) => { print(e) }
  }
}
