// ADR-282 / CORE-0.9-MAP-ASSIGN-20260926 — gemelo put (ADR-237) de 03-eq-put.arita; idéntico salvo m[k] = v → m.put(k, v)
// oracle: core09-map-assign-eq-put (gemelo put)
module core09_map_assign_eq_put_twin

fn main() -> Io<()> {
  let mut m: Map<Text, Int> = Map::new()
  m.put("a", 7)
  m.put("b", 3)
  m.put("a", 9)
  // Lectura con clave ident: m["a"] literal emite get(&"a".to_string()) (ADR-266) → clippy unnecessary_to_owned (preexistente, fuera de 282).
  let q: Text = "a"
  let o: Option<Int> = m[q]
  if let Some(x) = o {
    print(x)
  } else {
    print(0)
  }
  print(m.len())
}
