// ADR-285 / CORE-0.9-REF-MUT-20260926 — neg: `v[-1] = x` (lit negativo) en fn → Result → E0319 (ADR-285 §2 L56; ADR-281 L99 D3, L128)
// Forma ref-mut (ADR-285 §1 L35–37).
// Ofensor único: L14 `v[-1] = x`. Sin L14 → build verde.
// oracle: neg-core09-ref-vec-assign-neg-lit
module core09_ref_mut_neg_vec_neg_lit

fn apply(i: Int, x: Int) -> Result<Int, Int> {
  let mut m: Map<Text, Int> = Map::new()
  m["k"] = x
  let mut v: Vec<Int> = Vec::new()
  v.push(0)
  v.push(0)
  v[i] = x
  v[-1] = x
  let o: Option<Int> = v.get(i)
  match o {
    Some(y) => { Ok(y) }
    None => { Err(1) }
  }
}

fn run(i: Int, x: Int) -> Result<Int, Int> {
  let a: Int = apply(i, x)?
  Ok(a)
}

fn main() -> Io<()> {
  match run(1, 9) {
    Ok(a) => { print(a) }
    Err(e) => {
      print("err")
      print(e)
    }
  }
}
