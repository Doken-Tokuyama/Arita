// ADR-283 / CORE-0.9-VEC-ASSIGN-20260926 — self-ref R2: v[0] = v.len() (índice/valor a temporales antes del &mut); stdout "3"
module core09_vec_assign_self_ref

fn f() -> Result<Int, Int> {
  let mut v: Vec<Int> = Vec::new()
  v.push(1)
  v.push(2)
  v.push(3)
  v[0] = v.len()
  let o: Option<Int> = v.get(0)
  match o {
    Some(x) => { Ok(x) }
    None => { Err(1) }
  }
}

fn main() -> Io<()> {
  match f() {
    Ok(x) => { print(x) }
    Err(e) => { print(e) }
  }
}
