// ADR-283 §2 neg-core09-vec-assign-unwrap (fixture de Measure) — ligar `let r: Result<(), Int> = v.set(i, x)` y `r.unwrap()` → E0206
// (pin ADR-283 §2: mismo código exacto que los negs invent-unwrap existentes, E0206; ≠ E0291 reopen).
// Se liga primero: la forma encadenada v.set(0, 2).unwrap() probablemente da E0006 (ADR-283 §2), no se encadena.
module core09_vec_assign_neg_unwrap

fn main() -> Io<()> {
  let mut v: Vec<Int> = Vec::new()
  v.push(1)
  let r: Result<(), Int> = v.set(0, 2)
  r.unwrap()
  print(v.len())
}
