// ADR-283 / CORE-0.9-VEC-ASSIGN-20260926 — neg: v[-1] = "x" → E0319 (azúcar: E0344 > E0319 > E0203; Ingeniero 22:20 §1)
module core09_vec_assign_neg_lit_text

fn f(n: Int) -> Result<Int, Int> {
  let mut v: Vec<Int> = Vec::new()
  v.push(1)
  v[-1] = "x"
  Ok(n)
}

fn main() -> Io<()> {
  match f(1) {
    Ok(x) => { print(x) }
    Err(e) => { print(e) }
  }
}
