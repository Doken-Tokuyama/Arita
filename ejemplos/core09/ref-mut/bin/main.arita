// ADR-285 / CORE-0.9-REF-MUT-20260926 — CLI happy: args/JSON → lib load_arg → run (apply? ×2 + Map commit) + apply → main match
// Entrada (lib load_arg): cli_arg(1) = ruta JSON; sin arg → ejemplos/core09/ref-mut/fixture.json (la del scenario; cwd = raíz del repo)
// Fixture {"i": 1, "x": 9} → stdout exacto: "2" (run: m["hits"] tras overwrite, vía v[0]) · "9" (apply: v[1] = x in-bounds) · "3" (m.len() en main) · "ref-mut-happy"
// main Io<()>: CERO ? y CERO v[i] = ; solo m[k] = v (282, total) + match Ok/Err (sin unwrap)
module arita_ref_mut

use lib::apply
use lib::run
use lib::load_arg

fn main() -> Io<()> {
  let mut m: Map<Text, Int> = Map::new()
  match load_arg("ejemplos/core09/ref-mut/fixture.json", "i") {
    Ok(i) => {
      m["i"] = i
      match load_arg("ejemplos/core09/ref-mut/fixture.json", "x") {
        Ok(x) => {
          match run(i, x) {
            Ok(n) => {
              m["hits"] = n
              match apply(i, x, i) {
                Ok(s) => {
                  m["slot"] = s
                  print(n)
                  print(s)
                  print(m.len())
                  print("ref-mut-happy")
                }
                Err(e) => {
                  print("ref-mut-err")
                  print(e)
                }
              }
            }
            Err(e) => {
              print("ref-mut-err")
              print(e)
            }
          }
        }
        Err(e) => {
          print("ref-mut-err")
          print(e)
        }
      }
    }
    Err(e) => {
      print("ref-mut-err")
      print(e)
    }
  }
}

scenario ref_mut_happy {
  acceptance "2"
  acceptance "9"
  acceptance "3"
  acceptance "ref-mut-happy"
}
