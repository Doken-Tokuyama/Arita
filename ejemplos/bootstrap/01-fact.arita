// ADR-037 BOOTSTRAP-V0-20260914 — dual-oracle pure fn (factorial-lite)
// Golden: fact5() = 120 (same constant as Rust reference in arita-cli::bootstrap)
// Int helpers: Expr/Let only (no while) — unrolled 1*2*3*4*5.
module bootstrap_fact

fn fact5() -> Int {
  let a: Int = 1 * 2
  let b: Int = a * 3
  let c: Int = b * 4
  let d: Int = c * 5
  d
}

fn main() -> Io<()> {
  print(fact5())
}
