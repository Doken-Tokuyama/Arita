// ADR-068 BOOTSTRAP-04-20260918 — dual-oracle pure fn (fib-lite)
// Golden: fib7() = 13 (F0=0…F7=13; same constant as Rust reference in arita-cli::bootstrap)
// Int helpers: Expr/Let only (no while) — unrolled Fibonacci steps.
module bootstrap_fib7

fn fib7() -> Int {
  let a: Int = 0
  let b: Int = 1
  let c: Int = a + b
  let d: Int = b + c
  let e: Int = c + d
  let f: Int = d + e
  let g: Int = e + f
  let h: Int = f + g
  h
}

fn main() -> Io<()> {
  print(fib7())
}
