// ADR-112 BOOTSTRAP-09-20260918 — dual-oracle pure fn (fib-lite)
// Golden: fib12() = 144 (F0=0…F12=144; same constant as Rust reference in arita-cli::bootstrap)
// Int helpers: Expr/Let only (no while) — unrolled Fibonacci steps.
module bootstrap_fib12

fn fib12() -> Int {
  let a: Int = 0
  let b: Int = 1
  let c: Int = a + b
  let d: Int = b + c
  let e: Int = c + d
  let f: Int = d + e
  let g: Int = e + f
  let h: Int = f + g
  let i: Int = g + h
  let j: Int = h + i
  let k: Int = i + j
  let l: Int = j + k
  let m: Int = k + l
  m
}

fn main() -> Io<()> {
  print(fib12())
}
