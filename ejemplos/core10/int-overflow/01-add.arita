// ADR-292 / IA — add: overflow de `a + b` NO literal (parametros; sin plegado E0217) => panic uniforme, exit 101.
// stdout esperado (1 linea, antes del panic): before
module core10_int_overflow_add

fn add(a: Int, b: Int) -> Int {
  a + b
}

fn main() -> Io<()> {
  print("before")
  print(add(9223372036854775807, 1))
}
