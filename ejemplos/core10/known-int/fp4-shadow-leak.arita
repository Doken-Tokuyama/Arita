// ADR-294 KNOWN-INT-SCOPE (oraculo core10-known-int-fp4-shadow-leak): programa VALIDO que debe compilar y ejecutar.
// un `let a = MAX` interior (sombra en la rama) no debe contaminar el `a = 0` exterior. Sin ADR-294: E0217 falso por fuga de la sombra.
// stdout (medido con rustc por el Parser, 2026-10-04): 9223372036854775807 / 1 / ok; sin avisos de rustc.
module core10_known_int_fp4_shadow_leak
fn main() -> Io<()> {
  let a: Int = 0
  let n: Int = 3
  if n < 5 {
    let a: Int = 9223372036854775807
    print(a)
  }
  let r: Int = a + 1
  print(r)
  print("ok")
}
