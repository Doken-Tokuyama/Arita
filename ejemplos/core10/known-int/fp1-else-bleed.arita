// ADR-294 KNOWN-INT-SCOPE (oraculo core10-known-int-fp1-else-bleed): programa VALIDO que debe compilar y ejecutar.
// `a = MAX` solo en la rama `then`; el `else` hermano hace `a + 1` pero nunca se ejecuta (n = 3). Sin ADR-294, HIR rechazaba con E0217 por `known_int` filtrado entre ramas.
// stdout (medido con rustc por el Parser, 2026-10-04): ok; rustc avisa unused_assignments (warn; aceptado por el Ingeniero).
module core10_known_int_fp1_else_bleed
fn main() -> Io<()> {
  let mut a: Int = 0
  let n: Int = 3
  if n < 5 {
    a = 9223372036854775807
  } else {
    let r: Int = a + 1
    print(r)
  }
  print("ok")
}
