// ADR-286 / CORE-0.10-DEAD-SINK-20260927 — neg T09-12 (B-285-4): sumidero muerto en brazo Err → E0272 (ADR-286 §2 L69; P2(d) L38; P4 L40)
// fn→Result con `v[i] = 7` OOB → Err(0); main liga el payload a un binding sin uso e imprime un literal.
// Ofensor único: brazo Err L19–L22 (`let _c: Int = e` + `print("ok")`).
// Control: sustituir L20 por `print(e)` → build verde (quitar L20 a secas deja E0272 v1).
// oracle: neg-core10-dead-sink
module core10_dead_sink

fn tally(i: Int) -> Result<Int, Int> {
  let mut v: Vec<Int> = Vec::new()
  v.push(0)
  v[i] = 7
  let n: Int = v.len()
  Ok(n)
}

fn main() -> Io<()> {
  match tally(99) {
    Ok(n) => { print(n) }
    Err(e) => {
      let _c: Int = e
      print("ok")
    }
  }
}
