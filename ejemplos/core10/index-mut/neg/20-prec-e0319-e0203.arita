// ADR-290 Pin 3 / IM-5: en fn Result con índice literal negativo y rhs Text, gana E0319 sobre E0203
module core10_index_mut_neg_prec_319_203

fn f() -> Result<Int, Int> {
  let mut v: Vec<Int> = Vec::new()
  v.push(1)
  v[-1] += "x"
  Ok(1)
}

fn main() -> Io<()> {
  match f() {
    Ok(a) => { print(a) }
    Err(e) => { print(e) }
  }
}
