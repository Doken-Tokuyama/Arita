// ADR-278 / CORE-0.8-QMARK-20260926 — ? chain in fn→Result Ok path
module core08_qmark_chain

fn load(path: Text) -> Result<Text, Int> {
  let t: Text = host.read_text(path)?
  Ok(t)
}

fn pipeline(path: Text) -> Result<Text, Int> {
  let a: Text = load(path)?
  Ok(a)
}

fn main() -> Io<()> {
  let r: Result<Text, Int> = pipeline("ejemplos/core08/qmark/fixture.txt")
  match r {
    Ok(t) => { print(t) }
    Err(e) => {
      print("qmark_failed")
      print(e)
    }
  }
}
