// ADR-278 neg — ? on Option inside fn→Result → E0203 (no new E0xxx)
module core08_qmark_option

fn load(x: Int) -> Result<Int, Int> {
  let o: Option<Int> = Some(x)
  let v: Int = o?
  Ok(v)
}

fn main() -> Io<()> {
  let r: Result<Int, Int> = load(1)
  match r {
    Ok(t) => { print(t) }
    Err(e) => {
      print("qmark_failed")
      print(e)
    }
  }
}
