// ADR-278 — first ? hits Err → early return → main match fail path
module core08_qmark_err

fn load(path: Text) -> Result<Text, Int> {
  let t: Text = host.read_text(path)?
  Ok(t)
}

fn pipeline(path: Text) -> Result<Text, Int> {
  let a: Text = load(path)?
  Ok(a)
}

fn main() -> Io<()> {
  let r: Result<Text, Int> = pipeline("ejemplos/core08/qmark/missing-no-such-file.txt")
  match r {
    Ok(t) => { print(t) }
    Err(e) => {
      print("qmark_failed")
      print(e)
    }
  }
}
